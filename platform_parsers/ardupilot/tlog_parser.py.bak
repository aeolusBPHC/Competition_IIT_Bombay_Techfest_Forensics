from pathlib import Path
import struct

from platform_parsers.common.base_parser import BaseForensicParser


class ArduPilotTLogParser(BaseForensicParser):
    """
    Parser for ArduPilot/MAVLink telemetry logs (TLOG).

    Detection validates the binary TLOG structure rather than
    relying only on the .tlog filename extension.
    """

    platform_name = "ArduPilot"

    supported_formats = [
        "TLOG",
        ".tlog",
    ]

    TIMESTAMP_SIZE = 8

    @classmethod
    def identify(cls, evidence_path):
        path = Path(evidence_path)

        if not path.exists():
            return {
                "supported": False,
                "platform": cls.platform_name,
                "format": None,
                "confidence": "NONE",
                "reason": "File does not exist",
            }

        if not path.is_file():
            return {
                "supported": False,
                "platform": cls.platform_name,
                "format": None,
                "confidence": "NONE",
                "reason": "Evidence path is not a file",
            }

        try:
            result = cls._inspect_tlog(path)

            if result["valid"]:
                return {
                    "supported": True,
                    "platform": cls.platform_name,
                    "format": "TLOG",
                    "confidence": "HIGH",
                    "reason": result["reason"],
                    "indicators": result["indicators"],
                }

            return {
                "supported": False,
                "platform": cls.platform_name,
                "format": None,
                "confidence": "NONE",
                "reason": (
                    "File has a .tlog-compatible extension, "
                    "but valid MAVLink TLOG structure was not detected"
                ),
            }

        except Exception as exc:
            return {
                "supported": False,
                "platform": cls.platform_name,
                "format": None,
                "confidence": "ERROR",
                "reason": f"TLOG validation failed: {exc}",
            }

    @classmethod
    def _inspect_tlog(cls, path):
        """
        Validate a TLOG by attempting to parse timestamp + MAVLink
        packet records using pymavlink.

        We inspect only the first portion of the file during detection.
        """

        max_scan = 1024 * 1024

        with path.open("rb") as file:
            data = file.read(max_scan)

        if len(data) < cls.TIMESTAMP_SIZE + 8:
            return {
                "valid": False,
                "reason": "File is too small to contain a TLOG record",
                "indicators": [],
            }

        try:
            from pymavlink import mavutil
        except ImportError:
            return {
                "valid": False,
                "reason": "pymavlink is not installed",
                "indicators": [],
            }

        offset = 0
        records = 0
        mavlink_versions = set()
        message_types = []

        while offset + cls.TIMESTAMP_SIZE < len(data):

            # TLOG timestamp is 8-byte big-endian microseconds.
            timestamp_bytes = data[
                offset:
                offset + cls.TIMESTAMP_SIZE
            ]

            timestamp_us = struct.unpack(
                ">Q",
                timestamp_bytes
            )[0]

            # Reject obviously implausible timestamps.
            #
            # This is only a structural sanity check.
            if timestamp_us == 0:
                offset += 1
                continue

            packet_start = offset + cls.TIMESTAMP_SIZE

            # Look for MAVLink v1 or v2 packet start.
            magic_index = None

            for candidate in range(
                packet_start,
                min(packet_start + 16, len(data))
            ):
                if data[candidate] in (0xFE, 0xFD):
                    magic_index = candidate
                    break

            if magic_index is None:
                offset += 1
                continue

            try:
                parser = mavutil.mavlink.MAVLink(None)

                message = parser.parse_char(
                    data[magic_index:]
                )

                if message is None:
                    offset += 1
                    continue

                records += 1

                if data[magic_index] == 0xFE:
                    mavlink_versions.add("MAVLink 1")
                elif data[magic_index] == 0xFD:
                    mavlink_versions.add("MAVLink 2")

                message_types.append(
                    message.get_type()
                )

                # Advance beyond this timestamp.
                #
                # For detection we do not need to decode the
                # entire file.
                offset = magic_index + 2

                if records >= 5:
                    break

            except Exception:
                offset += 1

        if records == 0:
            return {
                "valid": False,
                "reason": "No valid MAVLink records detected",
                "indicators": [],
            }

        return {
            "valid": True,
            "reason": (
                "MAVLink telemetry records detected in "
                "TLOG-compatible binary structure"
            ),
            "indicators": {
                "records_detected": records,
                "mavlink_versions": sorted(mavlink_versions),
                "message_types": message_types,
            },
        }

    def get_metadata(self):
        return self._empty_metadata()

    def extract_gps(self):
        return []

    def extract_commands(self):
        return []

    def extract_command_acks(self):
        return []

    def extract_states(self):
        return []

    def extract_parameters(self):
        return []

    def extract_events(self):
        return []

    def _empty_metadata(self):
        from platform_parsers.common.evidence_model import EvidenceMetadata

        return EvidenceMetadata(
            source_file=str(self.evidence_path),
            platform=self.platform_name,
            format="TLOG",
        )
