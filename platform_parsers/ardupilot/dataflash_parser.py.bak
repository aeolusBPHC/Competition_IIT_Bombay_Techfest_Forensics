from pathlib import Path
import struct

from platform_parsers.common.base_parser import BaseForensicParser
from platform_parsers.common.evidence_model import (
    EvidenceMetadata,
    GPSRecord,
    CommandRecord,
    CommandAckRecord,
    StateRecord,
    ParameterRecord,
    ForensicEvent,
)


class ArduPilotDataFlashParser(BaseForensicParser):

    platform_name = "ArduPilot"
    supported_formats = ["DataFlash", ".bin", ".log"]

    # =========================================================
    # DATAFLASH CONSTANTS
    # =========================================================

    # DataFlash packet header:
    #
    #   0xA3 0x95 <message type>
    #
    HEADER = b"\xA3\x95"

    HEADER_LEN = 3

    # ArduPilot FMT message type
    FMT_MESSAGE_ID = 128

    # Every FMT record occupies 89 bytes
    FMT_RECORD_LEN = 89

    # =========================================================
    # DATAFLASH FORMAT TYPES
    # =========================================================

    FORMAT_TYPES = {

        # Array of 32 signed 16-bit integers
        "a": ("int16_array_32", 64),

        # Signed / unsigned 8-bit
        "b": ("int8", 1),
        "B": ("uint8", 1),

        # Signed / unsigned 16-bit
        "h": ("int16", 2),
        "H": ("uint16", 2),

        # Signed / unsigned 32-bit
        "i": ("int32", 4),
        "I": ("uint32", 4),

        # Floating point
        "f": ("float", 4),
        "d": ("double", 8),

        # Character arrays
        "n": ("char4", 4),
        "N": ("char16", 16),
        "Z": ("char64", 64),

        # ArduPilot special types
        #
        # c is a signed 8-bit value.
        "c": ("int16", 2),

        "C": ("uint16", 2),

        "e": ("int32", 4),
        "E": ("uint32", 4),

        # Latitude/longitude.
        # Stored as a signed 32-bit integer and
        # normalized later using 1e7.
        "L": ("latlon", 4),

        # Flight mode
        "M": ("flight_mode", 1),

        # Signed / unsigned 64-bit
        "q": ("int64", 8),
        "Q": ("uint64", 8),
    }

    # =========================================================
    # INITIALIZATION
    # =========================================================

    def __init__(self, evidence_path):

        super().__init__(evidence_path)

        self._data = None
        self._schemas = {}

        # Reserved for future record caching.
        self._records = []

    # =========================================================
    # IDENTIFICATION
    # =========================================================

    @classmethod
    def identify(cls, evidence_path):

        path = Path(evidence_path)

        # -----------------------------------------------------
        # File existence
        # -----------------------------------------------------

        if not path.exists() or not path.is_file():

            return {
                "supported": False,
                "platform": cls.platform_name,
                "format": "DataFlash",
                "confidence": "NONE",
                "reason": "File does not exist",
            }

        # -----------------------------------------------------
        # Extension
        # -----------------------------------------------------

        if path.suffix.lower() not in {
            ".bin",
            ".log",
        }:

            return {
                "supported": False,
                "platform": cls.platform_name,
                "format": "DataFlash",
                "confidence": "NONE",
                "reason": "Unsupported file extension",
            }

        try:

            data = path.read_bytes()

            # -------------------------------------------------
            # Minimum size
            # -------------------------------------------------

            if len(data) < cls.FMT_RECORD_LEN:

                raise ValueError(
                    "File too small"
                )

            # -------------------------------------------------
            # Scan FMT records
            # -------------------------------------------------

            schemas = cls._scan_fmt_records(
                data
            )

            if not schemas:

                raise ValueError(
                    "No valid FMT records found"
                )

            return {
                "supported": True,
                "platform": cls.platform_name,
                "format": "DataFlash",
                "confidence": "HIGH",
                "reason": (
                    "Valid ArduPilot DataFlash "
                    "structure detected with "
                    f"{len(schemas)} FMT record(s)"
                ),
                "indicators": {

                    "packet_header": "A3 95",

                    "fmt_records": list(
                        schemas.values()
                    ),

                    "message_names": [
                        schema["name"]
                        for schema
                        in schemas.values()
                    ],
                },
            }

        except Exception as exc:

            return {
                "supported": False,
                "platform": cls.platform_name,
                "format": "DataFlash",
                "confidence": "NONE",
                "reason": (
                    "DataFlash structure "
                    f"validation failed: {exc}"
                ),
            }

    # =========================================================
    # FMT SCHEMA SCANNER
    # =========================================================

    @classmethod
    def _scan_fmt_records(cls, data):

        schemas = {}

        offset = 0

        while (
            offset + cls.FMT_RECORD_LEN
            <= len(data)
        ):

            # -------------------------------------------------
            # Find next DataFlash header
            # -------------------------------------------------

            header = data.find(
                cls.HEADER,
                offset
            )

            if header < 0:
                break

            # -------------------------------------------------
            # Make sure complete FMT record exists
            # -------------------------------------------------

            if (
                header + cls.FMT_RECORD_LEN
                > len(data)
            ):

                break

            # -------------------------------------------------
            # Message ID
            # -------------------------------------------------

            msg_id = data[
                header + 2
            ]

            # -------------------------------------------------
            # Not FMT
            # -------------------------------------------------

            if msg_id != cls.FMT_MESSAGE_ID:

                offset = header + 2
                continue

            packet = data[
                header:
                header + cls.FMT_RECORD_LEN
            ]

            # -------------------------------------------------
            # FMT fields
            # -------------------------------------------------

            type_id = packet[3]

            msg_len = packet[4]

            name = (
                packet[5:9]
                .split(
                    b"\x00",
                    1
                )[0]
                .decode(
                    "ascii",
                    errors="replace"
                )
            )

            fmt = (
                packet[9:25]
                .split(
                    b"\x00",
                    1
                )[0]
                .decode(
                    "ascii",
                    errors="replace"
                )
            )

            labels = (
                packet[25:89]
                .split(
                    b"\x00",
                    1
                )[0]
                .decode(
                    "ascii",
                    errors="replace"
                )
            )

            # -------------------------------------------------
            # Validate FMT record
            # -------------------------------------------------

            if (
                type_id == cls.FMT_MESSAGE_ID
                or not name
                or not fmt
            ):

                offset = header + 2
                continue

            # -------------------------------------------------
            # Validate format characters
            # -------------------------------------------------

            if any(
                char not in cls.FORMAT_TYPES
                for char in fmt
            ):

                offset = header + 2
                continue

            # -------------------------------------------------
            # Store schema
            # -------------------------------------------------

            schemas[type_id] = {

                "message_type": type_id,

                "message_length": msg_len,

                "name": name,

                "format": fmt,

                "labels": labels,

                "offset": header,
            }

            offset = (
                header +
                cls.FMT_RECORD_LEN
            )

        return schemas

    # =========================================================
    # LOADING
    # =========================================================

    def _load(self):

        if self._data is None:

            self._data = (
                self.evidence_path.read_bytes()
            )

        if not self._schemas:

            self._schemas = (
                self._scan_fmt_records(
                    self._data
                )
            )

        return self._data

    # =========================================================
    # GENERIC DATAFLASH FIELD DECODER
    # =========================================================

    @classmethod
    def _decode_format(
        cls,
        payload,
        fmt,
    ):

        values = []

        offset = 0

        for code in fmt:

            # -------------------------------------------------
            # Supported format?
            # -------------------------------------------------

            if code not in cls.FORMAT_TYPES:

                raise ValueError(
                    "Unsupported DataFlash "
                    f"format character: {code}"
                )

            type_name, size = (
                cls.FORMAT_TYPES[code]
            )

            # -------------------------------------------------
            # Enough bytes?
            # -------------------------------------------------

            if (
                offset + size
                > len(payload)
            ):

                raise ValueError(
                    "Payload too short for "
                    f"format '{fmt}'"
                )

            chunk = payload[
                offset:
                offset + size
            ]

            # =================================================
            # ARRAY
            # =================================================

            if code == "a":

                value = list(
                    struct.unpack(
                        "<32h",
                        chunk
                    )
                )

                values.append(value)

                offset += size

                continue

            # =================================================
            # 8-BIT INTEGER
            # =================================================

            elif code == "b":

                value = struct.unpack(
                    "<b",
                    chunk
                )[0]

            elif code == "B":

                value = struct.unpack(
                    "<B",
                    chunk
                )[0]

            # =================================================
            # 16-BIT INTEGER
            # =================================================

            elif code == "h":

                value = struct.unpack(
                    "<h",
                    chunk
                )[0]

            elif code == "H":

                value = struct.unpack(
                    "<H",
                    chunk
                )[0]

            # =================================================
            # 32-BIT INTEGER
            # =================================================

            elif code == "i":

                value = struct.unpack(
                    "<i",
                    chunk
                )[0]

            elif code == "I":

                value = struct.unpack(
                    "<I",
                    chunk
                )[0]

            # =================================================
            # FLOATING POINT
            # =================================================

            elif code == "f":

                value = struct.unpack(
                    "<f",
                    chunk
                )[0]

            elif code == "d":

                value = struct.unpack(
                    "<d",
                    chunk
                )[0]

            # =================================================
            # 64-BIT INTEGER
            # =================================================

            elif code == "q":

                value = struct.unpack(
                    "<q",
                    chunk
                )[0]

            elif code == "Q":

                value = struct.unpack(
                    "<Q",
                    chunk
                )[0]

            # =================================================
            # ARDUPILOT SPECIAL INTEGER TYPES
            # =================================================

            elif code == "c":

                value = struct.unpack(
                    "<h",
                    chunk
                )[0]

            elif code == "C":

                value = struct.unpack(
                    "<H",
                    chunk
                )[0]

            elif code == "e":

                value = struct.unpack(
                    "<i",
                    chunk
                )[0]

            elif code == "E":

                value = struct.unpack(
                    "<I",
                    chunk
                )[0]

            elif code == "L":

                value = struct.unpack(
                    "<i",
                    chunk
                )[0]

            elif code == "M":

                value = struct.unpack(
                    "<B",
                    chunk
                )[0]

            # =================================================
            # STRING / CHARACTER ARRAYS
            # =================================================

            elif code in {
                "n",
                "N",
                "Z",
            }:

                value = (
                    chunk
                    .split(
                        b"\x00",
                        1
                    )[0]
                    .decode(
                        "ascii",
                        errors="replace"
                    )
                )

            # =================================================
            # UNKNOWN
            # =================================================

            else:

                raise ValueError(
                    f"Unhandled format code: {code}"
                )

            values.append(value)

            offset += size

        return values

    # =========================================================
    # RECORD ITERATOR
    # =========================================================

    def _iter_records(self):

        data = self._load()

        offset = 0

        while (
            offset + self.HEADER_LEN
            <= len(data)
        ):

            # -------------------------------------------------
            # Find next packet header
            # -------------------------------------------------

            header = data.find(
                self.HEADER,
                offset
            )

            if header < 0:
                break

            # -------------------------------------------------
            # Header complete?
            # -------------------------------------------------

            if (
                header + self.HEADER_LEN
                > len(data)
            ):

                break

            # -------------------------------------------------
            # Message ID
            # -------------------------------------------------

            msg_id = data[
                header + 2
            ]

            # -------------------------------------------------
            # Find schema
            # -------------------------------------------------

            schema = self._schemas.get(
                msg_id
            )

            if schema is None:

                offset = header + 2
                continue

            # -------------------------------------------------
            # Message length
            # -------------------------------------------------

            msg_len = schema[
                "message_length"
            ]

            if msg_len < self.HEADER_LEN:

                offset = header + 2
                continue

            # -------------------------------------------------
            # Packet end
            # -------------------------------------------------

            end = (
                header +
                msg_len
            )

            if end > len(data):

                break

            packet = data[
                header:end
            ]

            # -------------------------------------------------
            # Remove 3-byte DataFlash header
            # -------------------------------------------------

            payload = packet[3:]

            expected_payload_len = (
                msg_len - 3
            )

            if (
                len(payload)
                != expected_payload_len
            ):

                offset = header + 2
                continue

            # =================================================
            # DECODE
            # =================================================

            try:

                values = (
                    self._decode_format(
                        payload,
                        schema["format"],
                    )
                )

                labels = [
                    label.strip()
                    for label in
                    schema["labels"].split(",")
                ]

                # -------------------------------------------------
                # Important forensic validation.
                #
                # Number of labels must match number of decoded
                # values. Otherwise zip() could silently shift
                # fields and produce corrupted evidence.
                # -------------------------------------------------

                if len(labels) != len(values):

                    raise ValueError(
                        "FMT schema mismatch: "
                        f"{schema['name']} has "
                        f"{len(values)} decoded values "
                        f"but {len(labels)} labels"
                    )

                record = {

                    "message_type": msg_id,

                    "name": schema["name"],

                    "format": schema["format"],

                    "labels": labels,

                    "values": values,

                    "raw": packet,

                    "offset": header,
                }

                yield record

                # -------------------------------------------------
                # Move to next packet
                # -------------------------------------------------

                offset = end

            except Exception as exc:

                # -------------------------------------------------
                # Development diagnostic.
                #
                # Later this should become a structured forensic
                # decoding-error record instead of stdout output.
                # -------------------------------------------------

                print(
                    "DECODE ERROR: "
                    f"message={schema['name']} "
                    f"type={msg_id} "
                    f"offset={header} "
                    f"error={exc}"
                )

                # Move forward so that one malformed record
                # doesn't stop the entire evidence parse.
                offset = header + 2

    # =========================================================
    # METADATA
    # =========================================================

    def get_metadata(self):

        self._load()

        return EvidenceMetadata(

            source_file=str(
                self.evidence_path
            ),

            platform=self.platform_name,

            format="DataFlash",

            metadata={

                "schema_count": len(
                    self._schemas
                ),

                "message_types": [
                    schema["name"]
                    for schema
                    in self._schemas.values()
                ],
            },
        )

    # =========================================================
    # GPS
    # =========================================================

    def extract_gps(self):

        gps_records = []

        for record in self._iter_records():

            if record["name"] not in {
                "GPS",
                "GPS2",
            }:

                continue

            values = record["values"]

            labels = record["labels"]

            fields = dict(
                zip(
                    labels,
                    values
                )
            )

            # -------------------------------------------------
            # Timestamp
            # -------------------------------------------------

            timestamp = fields.get(
                "TimeUS"
            )

            # -------------------------------------------------
            # Latitude
            # -------------------------------------------------

            latitude = fields.get(
                "Lat"
            )

            # -------------------------------------------------
            # Longitude
            # -------------------------------------------------

            longitude = fields.get(
                "Lng"
            )

            if longitude is None:

                longitude = fields.get(
                    "Lon"
                )

            # -------------------------------------------------
            # Altitude
            # -------------------------------------------------

            altitude = fields.get(
                "Alt"
            )

            if altitude is None:

                altitude = fields.get(
                    "RAlt"
                )

            # -------------------------------------------------
            # Other GPS fields
            # -------------------------------------------------

            speed = fields.get(
                "Spd"
            )

            satellites = fields.get(
                "NSats"
            )

            hdop = fields.get(
                "HDop"
            )

            # =================================================
            # NORMALIZATION
            # =================================================

            # ArduPilot L format stores latitude/longitude
            # using a 1e7 scaling factor.

            if latitude is not None:

                latitude = (
                    latitude / 1e7
                )

            if longitude is not None:

                longitude = (
                    longitude / 1e7
                )

            # GPS altitude is represented in centimeters
            # in the relevant DataFlash GPS fields.

            if altitude is not None:

                altitude = (
                    altitude / 100.0
                )

            # DataFlash TimeUS is microseconds.

            if timestamp is not None:

                timestamp = (
                    timestamp /
                    1_000_000.0
                )

            gps_records.append(

                GPSRecord(

                    timestamp=timestamp,

                    latitude=latitude,

                    longitude=longitude,

                    altitude_m=altitude,

                    speed_m_s=speed,

                    satellites=satellites,

                    hdop=hdop,

                    source_platform=(
                        self.platform_name
                    ),

                    raw=fields,
                )
            )

        return gps_records

    # =========================================================
    # COMMANDS
    # =========================================================

    def extract_commands(self):

        commands = []

        for record in self._iter_records():

            if record["name"] != "MAVC":

                continue

            fields = dict(
                zip(
                    record["labels"],
                    record["values"]
                )
            )

            commands.append(

                CommandRecord(

                    timestamp=self._timestamp(
                        fields
                    ),

                    command_id=fields.get(
                        "Cmd"
                    ),

                    source_system=fields.get(
                        "SS"
                    ),

                    source_component=fields.get(
                        "SC"
                    ),

                    target_system=fields.get(
                        "TS"
                    ),

                    target_component=fields.get(
                        "TC"
                    ),

                    parameters={
                        key: value
                        for key, value
                        in fields.items()
                        if key.startswith("P")
                    },

                    source_platform=(
                        self.platform_name
                    ),

                    raw=fields,
                )
            )

        return commands

    # =========================================================
    # STATES
    # =========================================================

    def extract_states(self):

        states = []

        for record in self._iter_records():

            if record["name"] not in {
                "MODE",
                "ARM",
            }:

                continue

            fields = dict(
                zip(
                    record["labels"],
                    record["values"]
                )
            )

            timestamp = self._timestamp(
                fields
            )

            # -------------------------------------------------
            # Flight mode
            # -------------------------------------------------

            flight_mode = fields.get(
                "Mode"
            )

            if flight_mode is None:

                flight_mode = fields.get(
                    "ModeNum"
                )

            # -------------------------------------------------
            # Armed state
            # -------------------------------------------------

            armed = None

            if record["name"] == "ARM":

                armed = fields.get(
                    "ArmState"
                )

            states.append(

                StateRecord(

                    timestamp=timestamp,

                    armed=armed,

                    flight_mode=flight_mode,

                    source_platform=(
                        self.platform_name
                    ),

                    raw=fields,
                )
            )

        return states

    # =========================================================
    # PARAMETERS
    # =========================================================

    def extract_parameters(self):

        parameters = []

        for record in self._iter_records():

            if record["name"] != "PARM":

                continue

            fields = dict(
                zip(
                    record["labels"],
                    record["values"]
                )
            )

            timestamp = self._timestamp(
                fields
            )

            name = fields.get(
                "Name"
            )

            value = fields.get(
                "Value"
            )

            if name is None:

                continue

            parameters.append(

                ParameterRecord(

                    timestamp=timestamp,

                    name=str(name),

                    value=value,

                    source_platform=(
                        self.platform_name
                    ),

                    raw=fields,
                )
            )

        return parameters

    # =========================================================
    # EVENTS
    # =========================================================

    def extract_events(self):

        events = []

        for record in self._iter_records():

            if record["name"] not in {
                "EV",
                "ERR",
                "MSG",
            }:

                continue

            fields = dict(
                zip(
                    record["labels"],
                    record["values"]
                )
            )

            timestamp = self._timestamp(
                fields
            )

            # -------------------------------------------------
            # EV
            # -------------------------------------------------

            if record["name"] == "EV":

                description = (
                    "ArduPilot event "
                    f"ID {fields.get('Id')}"
                )

            # -------------------------------------------------
            # ERR
            # -------------------------------------------------

            elif record["name"] == "ERR":

                description = (
                    "ArduPilot error "
                    f"subsystem="
                    f"{fields.get('Subsys')} "
                    f"code="
                    f"{fields.get('ECode')}"
                )

            # -------------------------------------------------
            # MSG
            # -------------------------------------------------

            else:

                description = fields.get(
                    "Message"
                )

            events.append(

                ForensicEvent(

                    timestamp=timestamp,

                    event_type=record["name"],

                    description=description,

                    source_platform=(
                        self.platform_name
                    ),

                    raw=fields,
                )
            )

        return events

    # =========================================================
    # COMMAND ACKS
    # =========================================================

    def extract_command_acks(self):

        # DataFlash MAVC records provide logged
        # command-related information.
        #
        # A separate generic COMMAND_ACK DataFlash
        # record is not guaranteed to exist.
        #
        # Therefore we do not synthesize ACK records.

        return []

    # =========================================================
    # HELPERS
    # =========================================================

    @staticmethod
    def _timestamp(fields):

        timestamp = fields.get(
            "TimeUS"
        )

        if timestamp is None:

            return None

        return (
            timestamp /
            1_000_000.0
        )
